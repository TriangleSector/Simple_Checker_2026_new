# Simple Checker Module Configuration
# Service: Steam Community / Web API
# Version: 4.2.0

[Module_Auth]
Endpoint=https://steamcommunity.com/login/home/
Method=POST
UserAgent=Mozilla/5.0 (Windows NT 10.0; Win64; x64)

[Parser_Settings]
ParseInventory=true
ParseBalance=true
ParseGames=true
CheckMarketLock=true

[Success_Trigger]
Keyword=steamid
Keyword_Gold=wallet_balance
Bad_Keyword=captcha_needed